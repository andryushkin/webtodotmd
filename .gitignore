node_modules/
dist/
*.DS_Store

# Packaged extension archives, built by build.sh and uploaded to the Web Store
*.zip

# Local agent settings
.claude/settings.local.json
# MCP servers wired up for one machine. `.claude/settings.json` is committed
# because the invariant hook belongs to the project; this is the other half —
# which servers a person happens to run locally, and an offer every cloner
# would otherwise be asked to accept.
.mcp.json
# Scratch checkouts for background agents; never part of the source tree.
.claude/worktrees/

# Captures handed over for a manual pass — a page's own HTML and what the
# conversion made of it. Megabytes, and someone else's text.
/inbox/

# Chrome Web Store material: listing copy, store translations, screenshots and
# banner sources. Kept out of the repository — it is dashboard input, not code.
/store/

# smotr review engine (docs/review/run is a wrapper; the engine lives outside)
*.baseline
.smotr-queue.json
.smotr-agent.log
