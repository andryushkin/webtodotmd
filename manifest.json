{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.0.0",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "permissions": ["clipboardWrite", "activeTab", "tabs", "sidePanel", "storage", "contextMenus", "downloads"],
  "commands": {
    "capture-and-copy": {
      "suggested_key": { "default": "Alt+M", "mac": "Alt+M" },
      "description": "Copy selection as Markdown"
    }
  },
  "action": {
    "default_title": "select2md",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["src/content/content-script.ts"]
  }]
}
