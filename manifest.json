{
  "manifest_version": 3,
  "name": "select2md",
  "version": "0.1.0",
  "description": "Capture page selections as Markdown",
  "permissions": ["clipboardWrite", "offscreen", "activeTab"],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "select2md"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["src/content.ts"]
  }]
}
