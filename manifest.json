{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.3.1",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "permissions": ["clipboardWrite", "activeTab", "tabs", "sidePanel", "storage", "contextMenus", "downloads", "scripting"],
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["src/content/content-script.ts"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "capture-and-copy": {
      "suggested_key": { "default": "Alt+M", "mac": "Alt+M" },
      "description": "Copy selection as Markdown"
    },
    "capture-and-append": {
      "suggested_key": { "default": "Alt+Shift+M", "mac": "Alt+Shift+M" },
      "description": "Capture selection and append to side panel"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "to .md",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "options_page": "src/settings/settings.html",
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  }
}
