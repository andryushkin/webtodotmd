{
  "manifest_version": 3,
  "name": "select2md",
  "version": "0.1.0",
  "description": "Capture page selections as Markdown",
  "permissions": ["clipboardWrite", "activeTab", "tabs", "sidePanel", "storage"],
  "action": {
    "default_title": "select2md",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["src/content/content-script.ts"]
  }]
}
