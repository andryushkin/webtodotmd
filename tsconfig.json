{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "customConditions": ["browser"],
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "typeRoots": ["./types"]
  },
  "include": ["src", "vendor", "types"],
  "exclude": ["src/**/__tests__/**"]
}
